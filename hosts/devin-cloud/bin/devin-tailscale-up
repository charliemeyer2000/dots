# Join Charlie's tailnet as an ephemeral, tag:devin node so a Devin session can
# reach the life gateway (life:443) and workstation services. Idempotent;
# auto-removed at session end.
#
# Auth is Tailscale workload identity federation, not an auth key: the session's
# Devin OIDC token (devin-oidc, installed by the org blueprint) is passed to
# `tailscale up --client-id/--id-token`; control verifies it against the Devin
# issuer, and the federated identity behind the client ID can only ever mint
# tag:devin. Nothing on the VM is secret -- the client ID is public and the
# token lives 60 s. tailscale/tailscaled come from nix (home.packages); resolve
# their absolute paths so the sudo calls work regardless of sudo's secure_path.
set -euo pipefail
: "${TS_DEVIN_OIDC_CLIENT_ID:?set the TS_DEVIN_OIDC_CLIENT_ID org var (Tailscale federated identity for tag:devin; not a secret)}"
TAG="${DEVIN_TS_TAG:-tag:devin}"
TS_HOSTNAME="${DEVIN_TS_HOSTNAME:-devin-$(hostname | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9-' '-' | sed 's/-*$//')}"

TS_BIN="$(command -v tailscale)"
TSD_BIN="$(command -v tailscaled)"
command -v devin-oidc >/dev/null 2>&1 || {
  echo "devin-tailscale-up: devin-oidc not found (org blueprint installs it via CognitionAI/actions/setup-devin-oidc)" >&2
  exit 1
}

ensure_daemon() {
  "$TS_BIN" status >/dev/null 2>&1 && return 0
  "$TS_BIN" status 2>&1 | grep -qi 'logged out' && return 0
  if command -v systemctl >/dev/null 2>&1 && systemctl list-unit-files tailscaled.service >/dev/null 2>&1; then
    sudo systemctl start tailscaled >/dev/null 2>&1 || true
    sleep 1
  fi
  "$TS_BIN" status >/dev/null 2>&1 && return 0
  "$TS_BIN" status 2>&1 | grep -qi 'logged out' && return 0
  sudo mkdir -p /var/lib/tailscale /var/run/tailscale
  args="--state=/var/lib/tailscale/tailscaled.state --socket=/var/run/tailscale/tailscaled.sock"
  [ -e /dev/net/tun ] || args="$args --tun=userspace-networking --socks5-server=localhost:1055"
  # redirect inside the root shell so the /var/log write is privileged too.
  sudo sh -c "nohup '$TSD_BIN' $args >/var/log/tailscaled.log 2>&1 &"
  sleep 2
}

ensure_daemon
# Tailscale's audience for a federated identity is always api.tailscale.com/<client id>.
ID_TOKEN="$(devin-oidc token --audience "api.tailscale.com/${TS_DEVIN_OIDC_CLIENT_ID}")"
sudo "$TS_BIN" up \
  --client-id="${TS_DEVIN_OIDC_CLIENT_ID}?ephemeral=true&preauthorized=true" \
  --id-token="$ID_TOKEN" \
  --advertise-tags="${TAG}" \
  --hostname="${TS_HOSTNAME}" \
  --accept-routes \
  --reset
sudo "$TS_BIN" status
